# --- deck (/srv/deck/.env on the Pi) ---
DECK_ROOT=/srv/deck
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
EXO_STT_ORDER=deepgram,gemini
EXO_DEEPGRAM_MODEL=nova-3
EXO_GEMINI_MODEL=gemini-2.5-flash
EXO_TTS_MODEL=aura-2-thalia-en
EXO_MIC_DEVICE=default
EXO_ARECORD_ARGS=-f S16_LE -r 16000 -c 1
EXO_MIN_WAV_BYTES=9600
EXO_BRIDGE_URL=http://<droplet-tailnet-name>:8765
EXO_BRIDGE_TOKEN=
# --- bridge (~/.config/exo/bridge.env on the droplet, user hermes) ---
EXO_BRIDGE_HOST=<droplet-tailnet-ip>
EXO_BRIDGE_PORT=8765
EXO_BOARD=exo
EXO_AGENTS=librarian,trader,portfolio,wallet,builder,researcher
EXO_TASK_MAX_RUNTIME=30m
EXO_TELEGRAM_CHAT_ID=
HERMES_BIN=hermes
API_SERVER_URL=http://127.0.0.1:8642
API_SERVER_KEY=
