# --- deck (/srv/deck/.env on the Pi) ---
DECK_ROOT=/srv/deck
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
EXO_STT_ORDER=deepgram,gemini
EXO_DEEPGRAM_MODEL=nova-3
EXO_GEMINI_MODEL=gemini-2.5-flash
EXO_TTS_MODEL=aura-2-thalia-en
EXO_MIC_DEVICE=default
EXO_ARECORD_ARGS=-f S16_LE -r 16000 -c 1
EXO_MIN_WAV_BYTES=9600
EXO_BRIDGE_URL=http://<droplet-tailnet-name>:8765
EXO_BRIDGE_TOKEN=
DECK_UPLOAD_TOKEN=
ULTRAHUMAN_API_TOKEN=
NOWNODES_API_KEY=
EXO_WALLETS_FILE=/srv/deck/wallets.json
EXO_WATCH_ADDRESSES=0x…,0x…
# deck-confirm: poll (default) = receipts of the deck's own sent txs; wss = Blockbook WebSocket on
# EXO_WATCH_ADDRESSES (needs the NOWNodes Pro plan; Start answers 403).
# EXO_CONFIRM_MODE=poll
EXO_MODULE_ADDRESS=0x…
# Optional (defaults shown)
# EXO_KIOSK_LISTEN=127.0.0.1:8080
# EXO_PLAYER=aplay
# RCLONE_CONFIG=/srv/deck/rclone.conf
# RING_DB=/srv/deck/ring.db
# RING_BACKFILL_FROM=2026-09-24
# RING_REFETCH_DAYS=3
# EXO_DECK_PKG=/srv/deck/app/deck
# DECK_PY=/srv/deck/venv/bin/python
# DECK_CAPTURE=/usr/local/bin/deck-capture
# DECK_KIOSK=/usr/local/bin/deck-kiosk
# EXO_HOT_KEYSTORE=/srv/deck/keys/hot.json   (keystore v3; the passphrase never goes in this file)
# EXO_HOT_PASSFILE=/run/exo/hot.pass         (tmpfs, written by exo-unlock after each boot)
# EXO_MAX_FEE_GWEI=300                       (the hot key refuses to sign above this maxFeePerGas)
# EXO_FREEZE_MAX_FEE_GWEI=1500               (the panic freeze bids 2x up to this; above it the fee is clamped, never refused)
# --- bridge (/srv/exo-guard/config/bridge.env on the droplet: user exoguard, mode 600; written by agents/install-bridge.sh) ---
# Never readable by the hermes user. The Hermes env has its own, much smaller list: agents/hermes.env.example.
EXO_BRIDGE_TOKEN=
# The narrow token: opens POST /guard only. The one bridge secret that is copied into the Hermes env.
EXO_GUARD_TOKEN=
EXO_BRIDGE_HOST=<droplet-tailnet-ip>
EXO_BRIDGE_PORT=8765
EXO_BOARD=exo
EXO_AGENTS=librarian,trader,portfolio,wallet,builder,researcher
EXO_TASK_MAX_RUNTIME=30m
EXO_TELEGRAM_CHAT_ID=
# Ledger writes for the Guardian: DSN of the exo_writer role. Lives only here. Unset = Guardian routes answer 503.
EXO_LEDGER_WRITER_DSN=
# Ledger reads for the kiosk: DSN of the read-only exo_reader role (chain/ledger/roles.sql). Unset = /ledger/* answer 503.
EXO_LEDGER_DSN=
# 1 = guard/freeze send real mainnet report transactions from the simulator key. Default 0: every run is a dry run.
EXO_GUARDIAN_BROADCAST=0
# exo_guardian from exoguard's own checkout (the unit sets it; listed for running the bridge by hand).
PYTHONPATH=/srv/exo-guard/argo-exo/chain/runner
# EXO_CRE_MANIFEST=/srv/exo-guard/argo-exo/chain/cre/workflow-manifest.json
# The kanban CLI, run AS hermes through one sudoers rule (agents/install-bridge.sh writes the wrapper).
HERMES_BIN=/usr/local/bin/exo-hermes
API_SERVER_URL=http://127.0.0.1:8642
API_SERVER_KEY=
