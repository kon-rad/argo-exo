# Copy to .env in exoguard's checkout on the droplet: /srv/exo-guard/argo-exo/chain/cre/.env, owned by exoguard,
# mode 600 (agents/install-bridge.sh creates it). NEVER in the hermes checkout or anywhere the hermes user can read:
# every Hermes agent runs as hermes. Never commit .env.
# Dedicated simulator key: it pays gas for reports through the mock forwarder and must sign nothing else. It is
# Guardian-equivalent: whoever holds it can write approval reports to ExoModule (approve any drain) or freeze it.
CRE_ETH_PRIVATE_KEY=
NOWNODES_API_KEY=
OPENROUTER_API_KEY=
# One line of JSON, validated strictly by src/lib/rules.ts PolicySchema (see README.md for an example).
POLICY_JSON=
