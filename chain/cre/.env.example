# Copy to .env on the machine that simulates (the droplet, as hermes). Never commit .env.
# Dedicated simulator key: it pays gas for reports through the mock forwarder and must sign nothing else.
CRE_ETH_PRIVATE_KEY=
NOWNODES_API_KEY=
OPENROUTER_API_KEY=
# One line of JSON, validated strictly by src/lib/rules.ts PolicySchema (see README.md for an example).
POLICY_JSON=
