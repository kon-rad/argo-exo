[Unit]
Description=agent-hub: Claude Code chats and the Telegram toggle for the Second Brain app (127.0.0.1 only)
After=network-online.target
Wants=network-online.target

# The Second Brain app runs sandboxed (no new privileges, read-only home), so this does the privileged half of its
# Agents page as hermes: `claude -p` chats on the subscription login, telegram-agent.sh. Bound to
# 127.0.0.1 behind AGENT_HUB_TOKEN (/etc/agent-hub/env, root 600; the same value is in /etc/secondbrain/env).
# Never loads ~/.hermes/.env. Plan: Areas/argo/argo-exo/plans/10-claude-code-agents.md §2.3 in the vault.
[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/argo-exo/agents/agent-hub
EnvironmentFile=/etc/agent-hub/env
Environment=HOME=/home/hermes
Environment=PATH=/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/home/hermes/argo-exo/agents/agent-hub:/home/hermes/argo-exo/agents/cc-dispatcher
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m agent_hub
# mixed: SIGTERM to the hub only; it closes each chat's stdin so claude finishes cleanly.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=10
# The hub plus up to two live chat processes (about 260 MB each, measured 2026-10-11).
MemoryMax=1200M

[Install]
WantedBy=multi-user.target
