# The Exo lines in the Hermes env (~hermes/.hermes/.env; per profile, <profile>/.env). Every Hermes agent can read
# this file, so it holds ONLY what an agent may hold. Never EXO_BRIDGE_TOKEN, a ledger DSN, or the simulator key:
# those live in /srv/exo-guard (user exoguard), which hermes can't read. See agents/install-bridge.sh.

# The bridge on the tailnet, and the narrow token that opens POST /guard only (install-bridge.sh step d copies it).
EXO_BRIDGE_URL=http://<droplet-tailnet-ip>:8765
EXO_GUARD_TOKEN=
# The agent Safe that proposals are made from (public address).
EXO_SAFE=0x…
# Set per profile by agents/install-profiles.sh (in <profile>/.env): proposals go out as source agent:<profile>.
# EXO_AGENT_PROFILE=wallet
# Optional: {address: label} JSON for the exo-wallet skill (default ~/.config/exo/address-book.json).
# EXO_ADDRESS_BOOK=/home/hermes/.config/exo/address-book.json
# The nownodes-chain skill's read-only key.
NOWNODES_API_KEY=
