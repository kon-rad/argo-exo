#!/usr/bin/env python3
"""Transaction approval queue for the NOWNodes key.

  deck-approve status        mode + queued transactions
  deck-approve manual        each transaction waits for a press of the key (default)
  deck-approve auto          approve each queued transaction automatically (CRE caps still apply)
  deck-approve add FILE.json queue a transaction (used by the wallet after CRE approves it; also for testing)
"""
import json, os, shutil, sys, time
from pathlib import Path

STATE = Path(os.environ.get("DECK_ROOT", "/srv/deck")) / "state"
QUEUE, MODE = STATE / "tx-queue", STATE / "approve-mode"


def mode():
    try:
        return MODE.read_text().strip().lower() or "manual"
    except OSError:
        return "manual"


def main(args):
    QUEUE.mkdir(parents=True, exist_ok=True)
    if args in (["manual"], ["auto"]):
        MODE.write_text(args[0] + "\n")
    elif len(args) == 2 and args[0] == "add":
        src = Path(args[1])
        json.loads(src.read_text())                       # refuse anything that isn't JSON
        name = f"{time.time_ns():020d}_{src.stem}.json"         # sorts oldest first
        tmp = QUEUE / (name + ".tmp")
        shutil.copyfile(src, tmp)
        tmp.replace(QUEUE / name)
        print(f"queued {name}")
    elif args not in ([], ["status"]):
        print(__doc__.strip())
        return 1
    pending = sorted(QUEUE.glob("*.json"))
    print(f"mode={mode()} queued={len(pending)}")
    for p in pending:
        try:
            tx = json.loads(p.read_text())
            print(f"  {p.name}: {tx.get('summary') or tx.get('to', '?')}")
        except Exception:
            print(f"  {p.name}: (unreadable)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
