#!/usr/bin/env bash
# Push new SD media to the cloud (encrypted), then record what the cloud holds for the kiosk.
# Remote "exo-media:" is an rclone crypt remote over a B2 key restricted to this bucket prefix.
# Until the remote is configured (Konrad does that once, on the Pi) this exits 0 after one log line,
# so the enabled timer stays quiet.
set -euo pipefail
ROOT="${DECK_ROOT:-/srv/deck}"
export RCLONE_CONFIG="${RCLONE_CONFIG:-$ROOT/rclone.conf}"
log(){ echo "deck-media-sync: $*"; }

command -v rclone >/dev/null || { log "rclone not installed, skipping"; exit 0; }
[ -s "$RCLONE_CONFIG" ] || { log "no rclone config at $RCLONE_CONFIG, skipping"; exit 0; }
rclone listremotes 2>/dev/null | grep -qx 'exo-media:' || { log "remote exo-media: not configured, skipping"; exit 0; }

mkdir -p "$ROOT/outbox/photos" "$ROOT/outbox/audio" "$ROOT/media/video" "$ROOT/state"
# --min-age keeps files still being uploaded by the clip (.part) or recorded out of the push
rclone copy "$ROOT/outbox/photos" exo-media:photos --min-age 30s --transfers 2 --exclude '*.part' --quiet
rclone copy "$ROOT/outbox/audio"  exo-media:audio  --min-age 30s --transfers 2 --exclude '*.part' --quiet
rclone copy "$ROOT/media/video"   exo-media:video  --min-age 60s --transfers 1 --exclude '*.part' --quiet
# manifest paths are relative to the remote root: photos/…, audio/…, video/…, matching the kiosk's rel paths
rclone lsf -R --files-only exo-media: \
  | python3 -c 'import json,sys,time; print(json.dumps({"synced_at": int(time.time()), "files": [l.strip() for l in sys.stdin if l.strip()]}))' \
  > "$ROOT/state/media-cloud.json.tmp"
mv "$ROOT/state/media-cloud.json.tmp" "$ROOT/state/media-cloud.json"
log "synced"
