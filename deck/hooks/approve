#!/bin/sh
# deck-buttons runs this with the item just moved into state/tx-approved/.
DECK_ROOT="${DECK_ROOT:-/srv/deck}"
PYTHONPATH="$DECK_ROOT/app/deck:$DECK_ROOT/app/packages/nownodes-py"
export DECK_ROOT PYTHONPATH
cd "$DECK_ROOT/app/deck" && exec "$DECK_ROOT/venv/bin/python" -m exo_deck.approve_hook "$1"
