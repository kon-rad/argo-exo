[Unit]
Description=Exo deck buttons, NOWNodes approve key and status LEDs
After=multi-user.target

[Service]
Type=simple
User=deck
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=PYTHONPATH=/srv/deck/app/deck
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
EnvironmentFile=/srv/deck/.env
ExecStart=/srv/deck/venv/bin/python3 /srv/deck/deck-buttons.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
