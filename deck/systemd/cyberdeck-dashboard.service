[Unit]
Description=Exo kiosk (VITURE dashboard)
After=network.target srv-deck.mount tailscaled.service

[Service]
Type=simple
User=deck
EnvironmentFile=/srv/deck/.env
Environment=PYTHONPATH=/srv/deck/app/deck
WorkingDirectory=/srv/deck/app/deck
ExecStart=/srv/deck/venv/bin/python3 -m exo_deck.kiosk
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
