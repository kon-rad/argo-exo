[Unit]
Description=Exo approval queue sync (exo-bridge -> onchain check -> state/tx-queue)
After=network-online.target

[Service]
User=deck
EnvironmentFile=/srv/deck/.env
Environment=PYTHONPATH=/srv/deck/app/deck:/srv/deck/app/packages/nownodes-py
ExecStart=/srv/deck/venv/bin/python -m exo_deck.queue_sync
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
