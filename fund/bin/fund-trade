#!/bin/sh
# fund-trade wrapper: runs the CLI from this checkout with FUND_PYTHON, the repo venv, or ~/.argo-fund/venv.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
for PY in "${FUND_PYTHON:-}" "$HERE/../.venv/bin/python" "$HOME/.argo-fund/venv/bin/python"; do
  [ -n "$PY" ] && [ -x "$PY" ] && break
  PY=python3
done
PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m fund_trade "$@"
