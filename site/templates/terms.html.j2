{% extends "base.html.j2" %}
{% block title %}{{ copy.title }} · {{ copy.labels.terms_title }}{% endblock %}
{% block body %}
<header class="terms-head">
  <a href="/"><div class="emblem-mount"><img src="/static/img/argo-emblem.png" alt="{{ copy.labels.terms_emblem_alt }}" width="120" height="150"></div></a>
  <hr class="rule-double">
  {% set words = copy.labels.terms_title.rsplit(" ", 1) %}<h1>{% if words | length == 2 %}{{ words[0] }} <span class="nowrap">{{ words[1] }}</span>{% else %}{{ words[0] }}{% endif %}</h1>
  <hr class="rule-double">
</header>

<section id="refund" aria-labelledby="refund-title">
  <h2 id="refund-title"><span class="numeral">§ I.</span><span class="heading">{{ copy.labels.refunds }}</span></h2>
  <p class="dropcap">{{ copy.terms.refund }}</p>
</section>
<section id="payment" aria-labelledby="payment-title">
  <h2 id="payment-title"><span class="numeral">§ II.</span><span class="heading">{{ copy.labels.payment }}</span></h2>
  <p>{{ copy.terms.payment }}</p>
  <dl class="facts">
    {% if preorder %}
    <dt>{{ copy.labels.network }}</dt><dd>{% if preorder.chainName %}{{ preorder.chainName }} ({{ copy.labels.chain_id }} {{ preorder.chainId }}){% else %}{{ copy.labels.chain_id }} {{ preorder.chainId }}{% endif %}</dd>
    <dt>{{ copy.labels.contract }}</dt><dd><a href="{{ preorder.explorer }}/address/{{ preorder.contract }}"><code>{{ preorder.contract }}</code></a></dd>
    {% endif %}
    <dt>{{ copy.labels.receipt }}</dt><dd>{{ copy.terms.receipt }}</dd>
    <dt>{{ copy.labels.price }}</dt><dd>{{ copy.terms.price }}</dd>
  </dl>
</section>
<section id="shipping" aria-labelledby="shipping-title">
  <h2 id="shipping-title"><span class="numeral">§ III.</span><span class="heading">{{ copy.labels.shipping }}</span></h2>
  <p>{{ copy.terms.shipping }}</p>
  <h3>{{ copy.labels.shipping_countries }}</h3>
  <ul>{% for c in copy.terms.countries %}<li>{{ c }}</li>{% endfor %}</ul>
</section>
{% endblock %}
