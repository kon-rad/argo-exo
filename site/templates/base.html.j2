<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{% block title %}{{ copy.title }}{% endblock %}</title>
  <meta name="description" content="{% block description %}{{ copy.hero.lede }}{% endblock %}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&amp;display=swap">
  <link rel="stylesheet" href="/static/styles.css?v={{ asset_v["styles.css"] }}">
  <link rel="icon" href="/static/img/argo-emblem.png">
  {% if not release %}<meta name="robots" content="noindex">{% endif %}
</head>
<body>
<a class="skip" href="#main">{{ copy.labels.skip }}</a>
<div class="volume">
<nav class="topnav" aria-label="{{ copy.labels.header_nav }}">
  <a href="/">{{ copy.title }}</a>
  <span class="topnav-right"><a href="/token2049/">{{ copy.labels.token2049_link }}</a> · <a href="{{ copy.links.video }}" rel="noopener">{{ copy.labels.video_link }}</a> · <a href="/blog/">{{ copy.labels.blog_link }}</a></span>
</nav>
<main id="main">
{% block body %}{% endblock %}
</main>
<footer class="colophon">
  <hr class="rule-double">
  <img class="endpiece" src="/static/img/colophon-endpiece.png" alt="" width="240" height="48">
  <p>{{ copy.colophon }}</p>
  <nav aria-label="{{ copy.labels.footer_nav }}">
    <a href="/token2049/">{{ copy.labels.token2049_link }}</a> · <a href="/blog/">{{ copy.labels.blog_link }}</a> · <a href="{{ copy.links.video }}" rel="noopener">{{ copy.labels.video_link }}</a> · <a href="{{ copy.links.deck }}" rel="noopener">{{ copy.labels.deck_link }}</a> · <a href="https://github.com/kon-rad/argo-exo">{{ copy.labels.source_link }}</a> · <a href="https://myargoquest.com">{{ copy.labels.argo_link }}</a>
  </nav>
</footer>
</div>
</body>
</html>
