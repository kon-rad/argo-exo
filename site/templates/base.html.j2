<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{% block title %}{{ copy.title }}{% endblock %}</title>
  <meta name="description" content="{{ copy.hero.lede }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/static/styles.css">
  <link rel="icon" href="/static/img/argo-emblem.png">
  {% if not release %}<meta name="robots" content="noindex">{% endif %}
</head>
<body>
<a class="skip" href="#main">Skip to the text</a>
<div class="volume">
<main id="main">
{% block body %}{% endblock %}
</main>
<footer class="colophon">
  <hr class="rule-double">
  <img class="endpiece" src="/static/img/colophon-endpiece.png" alt="" width="240" height="48">
  <p>{{ copy.colophon }}</p>
  <nav aria-label="Colophon">
    <a href="/terms.html">Terms of the pre-order</a> · <a href="https://github.com/kon-rad/argo-exo">Source</a> · <a href="https://myargoquest.com">Argo</a>
  </nav>
</footer>
</div>
</body>
</html>
