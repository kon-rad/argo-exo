{% extends "base.html.j2" %}
{% macro section_head(key) %}{% set s = copy.sections[key] %}<h2 id="{{ key }}-title"><span class="numeral">§ {{ s.numeral }}.</span><span class="heading">{{ s.heading }}</span></h2>{% endmacro %}
{% block body %}
<header class="titlepage">
  <img class="logo" src="/static/img/argo-logo.png" alt="{{ copy.labels.emblem_alt }}" width="88" height="146">
  <hr class="rule-double">
  <p class="kicker">{{ copy.hero.kicker }}</p>
  <h1>{{ copy.title }}</h1>
  <p class="headline">{{ copy.hero.headline }}</p>
  <p class="lede">{{ copy.hero.lede }}</p>
  <hr class="rule-double">
  <a class="bookplate" href="#waitlist">{{ copy.hero.cta }}</a>
  <p class="deck-link"><a href="{{ copy.links.video }}" rel="noopener">{{ copy.labels.video_link }}</a> · <a href="{{ copy.links.deck }}" rel="noopener">{{ copy.labels.deck_link }}</a> · <a href="https://github.com/kon-rad/argo-exo" rel="noopener">{{ copy.labels.source_link }}</a></p>
</header>

<nav class="toc" aria-labelledby="toc-title">
  <h2 id="toc-title">{{ copy.contents_heading }}</h2>
  <ol class="contents">
    {% for key in ["features", "prototype", "kit", "waitlist", "faq"] %}{% set s = copy.sections[key] %}
    <li><span class="num">§ {{ s.numeral }}</span><a class="name" href="#{{ key }}">{{ s.heading }}</a></li>
    {% endfor %}
  </ol>
</nav>

<hr class="rule-hair">
<section id="features" aria-labelledby="features-title">
  {{ section_head("features") }}
  <p class="dropcap">{{ copy.sections.features.intro }}</p>
  <div class="figures">
    {% for f in features %}
    <figure id="fig-{{ f.fig }}" class="with-margin">
      <div class="plate-frame{{ ' photo' if f.img else '' }}{{ ' fit-contain' if f.fit == 'contain' else '' }}"><img src="/static/img/{{ f.img | default('plates/' ~ f.id ~ '.svg') }}" alt="{{ f.alt }}" width="{{ f.w | default(400) }}" height="{{ f.h | default(300) }}" loading="lazy"></div>
      <figcaption><span class="fig">Fig. {{ f.fig }}. {{ f.name }}.</span>
        <p class="blurb">{{ f.blurb }}</p>
        <span class="margin-note">cf. §{{ f.section }}</span></figcaption>
    </figure>
    {% endfor %}
  </div>
</section>

<hr class="rule-hair">
<section id="prototype" aria-labelledby="prototype-title">
  {{ section_head("prototype") }}
  <p class="dropcap">{{ copy.sections.prototype.intro }}</p>
  <h3>{{ copy.labels.photos_heading }}</h3>
  <div class="photo-grid">
    <figure class="photo-wide"><img src="/static/img/photos/bench-overhead.webp" alt="{{ copy.labels.photo_bench_alt }}" width="1600" height="1200" loading="lazy"><figcaption>{{ copy.labels.photo_bench }}</figcaption></figure>
    <figure><img src="/static/img/photos/bench-portrait.webp" alt="{{ copy.labels.photo_portrait_alt }}" width="1200" height="1600" loading="lazy"><figcaption>{{ copy.labels.photo_portrait }}</figcaption></figure>
    <div class="photo-stack">
      <figure><img src="/static/img/photos/camera-clip.webp" alt="{{ copy.labels.photo_clip_alt }}" width="652" height="758" loading="lazy"><figcaption>{{ copy.labels.photo_clip }}</figcaption></figure>
      <figure><img src="/static/img/photos/pi-zero-cold-key.webp" alt="{{ copy.labels.photo_zero_alt }}" width="416" height="194" loading="lazy"><figcaption>{{ copy.labels.photo_zero }}</figcaption></figure>
    </div>
  </div>
  <h3>{{ copy.labels.kiosk_heading }}</h3>
  <p class="note">{{ copy.labels.kiosk_note }}</p>
  <div class="kiosk-grid">
    {% for k in ["agents", "transactions", "wallets", "sensors", "media"] %}
    <figure class="{{ 'kiosk-wide' if loop.first else '' }}"><img src="/static/img/kiosk/{{ k }}.webp" alt="{{ copy.labels['kiosk_' ~ k ~ '_alt'] }}" width="1600" height="900" loading="lazy"><figcaption>{{ copy.labels['kiosk_' ~ k] }}</figcaption></figure>
    {% endfor %}
  </div>
</section>

<hr class="rule-hair">
<section id="renders" class="renders" aria-labelledby="renders-title">
  <h2 id="renders-title"><span class="heading">{{ copy.labels.renders_heading }}</span></h2>
  <p>{{ copy.labels.renders_note }} <a href="/blog/design-language.html">{{ copy.labels.renders_link }}</a></p>
  <div class="render-grid">
    {% for r in renders %}<img class="{{ 'render-wide' if r.wide else '' }}" src="/static/img/blog/design/{{ r.file }}.webp" alt="{{ r.alt }}" width="{{ r.w }}" height="{{ r.h }}" loading="lazy">
    {% endfor %}
  </div>
</section>

<hr class="rule-hair">
<section id="kit" aria-labelledby="kit-title">
  {{ section_head("kit") }}
  <p class="dropcap">{{ copy.sections.kit.intro }}</p>
  {% for t in tiers %}
  <article class="plate" data-tier="{{ t.tier }}" aria-labelledby="plate-{{ t.tier }}">
    <h3 id="plate-{{ t.tier }}"><span class="plate-no">Plate {{ t.plate }}.</span>{{ t.name }}</h3>
    <table>
      <tbody>{% for item in t.includes %}<tr><th scope="row">{{ loop.index }}.</th><td>{{ item }}</td></tr>{% endfor %}</tbody>
    </table>
  </article>
  {% endfor %}
</section>

<hr class="rule-hair">
<section id="waitlist" aria-labelledby="waitlist-title">
  {{ section_head("waitlist") }}
  <p class="dropcap">{{ copy.sections.waitlist.intro }}</p>
  <form class="waitlist" id="waitlist-form" novalidate data-msg='{{ {"thanks": copy.sections.waitlist.thanks, "invalid": copy.sections.waitlist.invalid, "busy": copy.sections.waitlist.busy, "failed": copy.sections.waitlist.failed} | tojson }}'>
    <label for="waitlist-email" class="visually-hidden">{{ copy.labels.email }}</label>
    <input type="email" id="waitlist-email" name="email" required maxlength="120" autocomplete="email" placeholder="{{ copy.sections.waitlist.placeholder }}">
    <button class="bookplate" type="submit">{{ copy.sections.waitlist.button }}</button>
  </form>
  <p class="status-line" id="waitlist-status" role="status"></p>
</section>

<hr class="rule-hair">
<section id="scan" aria-labelledby="scan-title">
  <h2 id="scan-title"><span class="heading">{{ copy.labels.token2049_title }}</span></h2>
  <p>{{ copy.labels.token2049_qr_note }} <a href="/token2049/">{{ copy.labels.token2049_link }}</a></p>
  <div class="qr-grid">
    {% for c in token2049.codes if c.slug in ["video", "slides", "github", "cre-evidence", "nownodes-evidence"] %}
    <figure><a href="{{ c.url }}" rel="noopener"><img src="/static/img/qr/{{ c.slug }}.svg" alt="QR code: {{ c.name }}" width="200" height="200" loading="lazy"></a><figcaption>{{ c.name }}</figcaption></figure>
    {% endfor %}
  </div>
</section>

<hr class="rule-hair">
<section id="faq" aria-labelledby="faq-title">
  {{ section_head("faq") }}
  {% for item in copy.sections.faq["items"] %}<h3>{{ item.q }}</h3><p>{{ item.a }}</p>{% endfor %}
</section>
{% if posts %}
<hr class="rule-hair">
<section id="notes" aria-labelledby="notes-title">
  <h2 id="notes-title"><span class="heading">{{ copy.labels.blog_title }}</span></h2>
  <ol class="post-list compact">
    {% for p in posts %}<li><h3><a href="/blog/{{ p.slug }}.html">{{ p.title }}</a></h3><p>{{ p.summary }}</p></li>
    {% endfor %}
  </ol>
</section>
{% endif %}
<script type="module" src="/static/waitlist.mjs"></script>
{% endblock %}
