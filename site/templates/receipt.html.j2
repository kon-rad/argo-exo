{% extends "base.html.j2" %}
{% block title %}{{ copy.title }} · {{ copy.labels.receipt_title }}{% endblock %}
{% block body %}
<div class="receipt-card" id="receipt" aria-live="polite"><p class="status-line">{{ copy.states.reading_receipt }}</p></div>
<form class="claim" id="claim-form" hidden>
  <p>{{ copy.receipt.claim_intro }} <span class="edition">{{ copy.labels.claim_number }} <span id="claim-n"></span></span></p>
  <label>{{ copy.labels.name }}<input name="name" required maxlength="80" autocomplete="name"></label>
  <label>{{ copy.labels.email }}<input name="email" type="email" required maxlength="120" autocomplete="email"></label>
  <label>{{ copy.labels.country }}<select name="country" required autocomplete="country-name">{% for c in copy.terms.countries %}<option>{{ c }}</option>{% endfor %}</select></label>
  <button class="bookplate" type="submit">{{ copy.receipt.submit }}</button>
  <p class="error" id="claim-error" role="alert" hidden></p>
</form>
<script type="application/json" id="checkout-copy">{{ {"states": {"paused": copy.states.paused, "sold_out": copy.states.sold_out, "unavailable": copy.states.unavailable}, "checkout": copy.checkout, "receipt": copy.receipt} | tojson }}</script>
<script type="module" src="/static/checkout.js"></script>
{% endblock %}
