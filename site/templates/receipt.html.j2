{% extends "base.html.j2" %}
{% block title %}{{ copy.title }} · Receipt{% endblock %}
{% block body %}
<div class="receipt-card" id="receipt" aria-live="polite"><p class="status-line">{{ copy.states.reading_receipt }}</p></div>
<form class="claim" id="claim-form" hidden>
  <p>{{ copy.receipt.claim_intro }} <span class="edition">No. <span id="claim-n"></span></span></p>
  <label>Name<input name="name" required maxlength="80" autocomplete="name"></label>
  <label>Email<input name="email" type="email" required maxlength="120" autocomplete="email"></label>
  <label>Shipping country<select name="country" required autocomplete="country-name">{% for c in copy.terms.countries %}<option>{{ c }}</option>{% endfor %}</select></label>
  <button class="bookplate" type="submit">{{ copy.receipt.submit }}</button>
  <p class="error" id="claim-error" role="alert" hidden></p>
</form>
<script type="module" src="/static/checkout.js"></script>
{% endblock %}
